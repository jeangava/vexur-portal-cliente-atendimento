# ------------------------------------------------------------------------------
# COMO USAR
# 1. Copie este arquivo e renomeie a cópia para  .env  (na mesma pasta).
# 2. Preencha os valores do seu lado. O .env NUNCA vai para o git (está no .gitignore)
#    e só o servidor do portal lê — o navegador do cliente nunca vê essas chaves.
# 3. Reinicie o servidor (npm run dev).
# ------------------------------------------------------------------------------

# Segredo da sessão (obrigatório fora do modo dev). Qualquer texto aleatório com 32+ caracteres.
NUXT_SESSION_PASSWORD=

# true = dados de teste (não chama nada). false = usa o gateway abaixo.
NUXT_MODO_MOCK=true
NUXT_PUBLIC_MODO_MOCK=true

# Situação da conta do mês no modo de teste: aberta | vence-hoje | atrasada
NUXT_MOCK_SITUACAO=aberta

# Endereço do gateway (stage Tecgroup usa o mesmo do legado: https://gateway-tecgroup.vexur.com.br)
NUXT_GATEWAY_URL=

# Trava: false = só leitura. true = libera inclusões, exclusões, processos e e-mails.
# Toda escrita liberada fica registrada no log do servidor (auditoria).
NUXT_PERMITIR_ESCRITA=false

# O sistema ainda não tem login com CPF + senha. true = entra só com o CPF (como o portal
# antigo) e a senha digitada NÃO é conferida. Use só para testar. Nunca em produção.
NUXT_LOGIN_SOMENTE_CPF=false
NUXT_PUBLIC_LOGIN_SOMENTE_CPF=false

# Chave (api-key) de cada serviço do gateway que o portal usa.
# São as mesmas chaves que o portal legado usa hoje para esses serviços.
NUXT_API_KEYS_SEGURANCA=
NUXT_API_KEYS_PORTAL_CLIENTE_SEGURANCA=
NUXT_API_KEYS_OPERACAO_RECEPCAO_PROPOSTA_ADESAO=
NUXT_API_KEYS_OPERACAO_IMPLANTACAO_CONTRATO_ADESAO=
NUXT_API_KEYS_FATURAMENTO_EXTRATO_CLIENTE=
NUXT_API_KEYS_FATURAMENTO_COBRANCA_GERAR=
NUXT_API_KEYS_FATURAMENTO_COBRANCA_ADMIN=
NUXT_API_KEYS_REGRA_VENDA_COMUNICACAO=
NUXT_API_KEYS_REGRA_ACEITACAO_DECLARACAO_SAUDE=
NUXT_API_KEYS_WORKFLOW_PROCESS=
NUXT_API_KEYS_REPOSITORIO_DOCUMENTOS=
NUXT_API_KEYS_GESTAO_ELETRONICA_DOCUMENTO=
NUXT_API_KEYS_REGRA_ACEITACAO_CALENDARIO=
NUXT_API_KEYS_GESTAO_PROTOCOLOS=
NUXT_API_KEYS_CHECKLIST_PRODUTO=
NUXT_API_KEYS_DOMINIO=
NUXT_API_KEYS_ENVIO_COMUNICACAO=
NUXT_API_KEYS_REGRA_SERVICOS_ONLINE=
NUXT_API_KEYS_LOCALIDADES=
NUXT_API_KEYS_REGRA_MOVIMENTACAO_ALTERACAO_CADASTRAL=
NUXT_API_KEYS_REGRA_VENDA_ACEITACAO_BENEFICIARIO=
NUXT_API_KEYS_REGRA_VENDA_TABELA_PRECO=
